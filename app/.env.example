# Postgres (Orchard-hosted)
DATABASE_URL=postgres://user:pass@host:5432/summercamp

# Public origin of this app (required for magic links, OIDC redirect, CSRF)
ORIGIN=https://app.camp.hackclub.com

# Magic-link email via Resend (in dev the link is logged to console instead)
RESEND_API_KEY=
EMAIL_FROM="Hack Club Summer Camp <camp@hackclub.com>"

# Hack Club Identity OIDC (auth.hackclub.com) — used only for the IDV step-up
HC_OIDC_CLIENT_ID=
HC_OIDC_CLIENT_SECRET=

# Unified YSWS Airtable sync
AIRTABLE_API_KEY=
YSWS_BASE_ID=
YSWS_ROSTER_TABLE=Campers
YSWS_TABLE=Approved Projects

# Hack Club CDN (project screenshot uploads)
CDN_API_KEY=

# Comma-separated emails promoted to admin on login
ADMIN_EMAILS=jenin@hackclub.com

# Enable the 5-minute Airtable sync loop (true in prod only)
SYNC_ENABLED=false
