# Postgres (Orchard-hosted)
DATABASE_URL=postgres://user:pass@host:5432/summercamp

# Public origin of this app (required for magic links, the OIDC redirect, CSRF,
# and the "Project page" link sent to Ari)
ORIGIN=https://app.camp.hackclub.com

# Hack Club Identity OIDC (auth.hackclub.com) — the identity step-up before
# shipping/shopping. YSWS eligibility is read from
# auth.hackclub.com/api/external/check (that call needs no credentials).
HC_OIDC_CLIENT_ID=
HC_OIDC_CLIENT_SECRET=

# Ari review (https://ari.hackclub.com). Program id + signing secret come from
# Ari → Settings → Webhooks; the secret signs ship ingests AND verifies the
# decision webhooks. ARI_BASE_URL is optional (defaults to ari.hackclub.com).
ARI_PROGRAM_ID=
ARI_SECRET=
ARI_BASE_URL=

# Airtable — ships go to the "YSWS Project Submission" table (YSWS base), and all
# outbound email is queued into the "Emails" table in the Loops-connected base
# (an Airtable automation hands each row to Loops to send). All table/base ids
# are optional and default to the camp's.
AIRTABLE_API_KEY=
YSWS_BASE_ID=
YSWS_SUBMISSION_TABLE=
EMAIL_BASE_ID=
EMAIL_TABLE=

# Slack notifications (review decisions, order updates). Bot token DMs campers by
# their stored slack_id. Optional channel to add approved builders to.
SLACK_BOT_TOKEN=
SLACK_APPROVED_CHANNEL_ID=

# Hack Club CDN (project screenshot uploads)
CDN_API_KEY=

# Comma-separated emails promoted to admin on login
ADMIN_EMAILS=jenin@hackclub.com
